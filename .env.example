# Copy to .env (git-ignored). Real environment variables win over .env.
# Folder holding Foundry's main.js
FOUNDRY_APP=/path/to/foundryvtt/14.xxx
FOUNDRY_NODE=node
# Foundry "Data" folder; .foundry-data/ in the repo is git-ignored
FOUNDRY_DATA=/path/to/repo/.foundry-data/Data
FOUNDRY_PORT=30001
FOUNDRY_WORLD=tor2eprint-test
SMOKE_USER=Gamemaster
SMOKE_PASSWORD=
# [user@]host:path/Data/modules/tor2eprint (the colon is required)
DEPLOY_TARGET=host:path/Data/modules/tor2eprint
