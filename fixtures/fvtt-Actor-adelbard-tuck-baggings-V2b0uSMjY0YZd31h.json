      "effects": [],
      "folder": "hVGLBs5UcUGbU9oT",
      "sort": 0,
      "flags": {
        "core": {}
      },
      "system": {
        "description": {
          "value": "<p>Your ways are simple, some might say even uncouth, but you know that not all that is gold does necessarily glitter.</p></br><p>&nbsp;</p>",
          "type": "String",
