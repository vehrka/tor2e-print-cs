    {
      "_id": "UEHUMRF7IQY0ZNNA",
      "name": "KINGS OF MEN (Rangers of the North)",
      "type": "trait",
      "img": "systems/tor2e/assets/images/icons/cultural-blessing.png",
      "effects": [],
      "flags": {
        "core": {}
      },
      "system": {
        "description": {
          "value": "<p>Some say that the lordship of the folk of Arnor is a thing of the past. Yet, the Rangers of the North have inherited the sinews of those Men who wrested the Ring from the burning hand of Sauron.</p><p><i>Add 1 point to one Attribute of your choice.</i></p><p></p><blockquote>They were fair of face and tall, and the span of their lives was thrice that of the Men of Middle-earth.</blockquote><p></p><br><p> </p>",
          "type": "String",
          "label": "tor2e.common.description"
        },
        "group": {
          "value": "distinctiveFeature",
          "type": "String",
