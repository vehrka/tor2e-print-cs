<li class="tf-skill">
  <span class="tf-box {{#if favoured}}is-on{{/if}}"></span>
  <span class="tf-skill-name">{{localize label}}{{#if magical}} <sup class="tf-mag">{{localize "TOR2EPRINT.Labels.Magical"}}</sup>{{/if}}</span>
  <span class="tf-pips">{{#each pips}}<span class="tf-dia tf-dia--pip {{#if filled}}is-on{{/if}}"></span>{{/each}}</span>
</li>
